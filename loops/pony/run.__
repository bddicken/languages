use "time"

primitive Parse
  fun i64(s: String): I64 =>
    var acc: I64 = 0
    for c in s.values() do
      if (c >= 48) and (c <= 57) then
        acc = (acc * 10) + (c.i64() - 48)
      end
    end
    acc

primitive Stats
  fun mean(a: Array[F64] box): F64 =>
    if a.size() == 0 then 0 else
      var s: F64 = 0
      for v in a.values() do s = s + v end
      s / a.size().f64()
    end
  fun variance(a: Array[F64] box): F64 =>
    if a.size() < 2 then 0 else
      let m = mean(a)
      var s: F64 = 0
      for v in a.values() do let d = v - m; s = s + (d * d) end
      s / (a.size().f64() - 1)
    end
  fun stddev(a: Array[F64] box): F64 => variance(a).sqrt()

actor Main
  new create(env: Env) =>
    try
      let args = env.args
      if args.size() < 4 then error end
      let run_ms = Parse.i64(args(1)?)
      let warm_ms = Parse.i64(args(2)?)
      let u = Parse.i64(args(3)?)

      let deadline_s = run_ms.f64() / 1000
      let warm_s = warm_ms.f64() / 1000

      let times = Array[F64]

      let t0 = Time.seconds()
      if warm_ms > 0 then
        while (Time.seconds() - t0) < warm_s do
          Loops.apply(u)
        end
      end

      let start = Time.seconds()
      var last_sec: I64 = 0
      while (Time.seconds() - start) < deadline_s do
        let s1 = Time.seconds()
        let r = Loops.apply(u)
        let s2 = Time.seconds()
        let ms = (s2 - s1) * 1000
        times.push(ms)
        if run_ms > 1 then
          let sec_now: I64 = (Time.seconds() - start).i64()
          if sec_now > last_sec then
            env.err.write(".".array())
            last_sec = sec_now
          end
        end
        (consume r) // ensure no elimination; unused
      end
      if run_ms > 1 then env.err.print("") end

      var min_v: F64 = 1.0e300
      var max_v: F64 = -1.0e300
      for v in times.values() do
        if v < min_v then min_v = v end
        if v > max_v then max_v = v end
      end
      let mean = Stats.mean(times)
      let sd = Stats.stddev(times)

      let result = Loops.apply(u)

      env.out.print("""
        $(mean),$(sd),$(min_v),$(max_v),$(times.size()),$(result)
      """.trim())
      env.exitcode(0)
    else
      env.err.print("usage: run <run_ms> <warmup_ms> <u>")
      env.exitcode(1)
    end
